<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:clipToOutline="true">
 <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_dusk_scene" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
  <LinearLayout android:id="@+id/widget_heading" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="top" android:paddingTop="4dp" android:contentDescription="打开 LYNK &amp; CO">
   <LinearLayout android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:orientation="vertical">
    <ImageView android:layout_width="match_parent" android:layout_height="24dp" android:paddingBottom="8dp" android:src="@drawable/lynk_wordmark" android:scaleType="fitStart" android:contentDescription="领克 LYNK &amp; CO"/>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:visibility="gone" android:textSize="11sp" android:textColor="#CDD3DD" android:maxLines="2" android:ellipsize="end"/>
   </LinearLayout>
   <LinearLayout android:layout_width="0dp" android:layout_weight="3" android:layout_height="1dp" android:importantForAccessibility="no"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:orientation="horizontal">
   <LinearLayout android:id="@+id/widget_close" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:contentDescription="关锁">
    <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:src="@drawable/ic_lock" android:background="@drawable/widget_key_circle" android:importantForAccessibility="no"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="关" android:textSize="17sp" android:textColor="#F5F7FA"/>
   </LinearLayout>
   <LinearLayout android:id="@+id/widget_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:contentDescription="开锁">
    <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:src="@drawable/ic_unlock" android:background="@drawable/widget_key_circle" android:importantForAccessibility="no"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="开" android:textSize="17sp" android:textColor="#F5F7FA"/>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>
</FrameLayout>
