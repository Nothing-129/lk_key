<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="@drawable/widget_background" android:clipToOutline="true">
 <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
  android:src="@drawable/widget_dusk_scene" android:scaleType="centerCrop"
  android:importantForAccessibility="no"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <LinearLayout android:id="@+id/widget_heading"
   android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
   android:orientation="vertical" android:gravity="top|start"
   android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="14dp"
   android:contentDescription="打开 LYNK &amp; CO">
   <ImageView android:layout_width="84dp" android:layout_height="14dp"
    android:src="@drawable/lynk_wordmark" android:scaleType="fitStart"
    android:contentDescription="领克 LYNK &amp; CO"/>
   <TextView android:id="@+id/widget_status"
    android:layout_width="120dp" android:layout_height="wrap_content"
    android:layout_marginTop="8dp" android:text="" android:visibility="gone"
    android:textSize="10sp" android:textColor="#CDD3DD" android:maxLines="2" android:ellipsize="end"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
   android:orientation="vertical" android:background="#1B2532">
   <ImageView android:layout_width="match_parent" android:layout_height="1dp"
    android:background="#10FFFFFF" android:importantForAccessibility="no"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
    <LinearLayout android:id="@+id/widget_close"
     android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
     android:gravity="center" android:background="@drawable/widget_control_feedback" android:contentDescription="关锁">
     <ImageView android:layout_width="16dp" android:layout_height="16dp"
      android:src="@drawable/ic_lock" android:importantForAccessibility="no"/>
     <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginStart="8dp" android:text="关锁" android:textSize="11sp" android:textColor="#F5F7FA"/>
    </LinearLayout>
    <ImageView android:layout_width="1dp" android:layout_height="match_parent"
     android:background="#12FFFFFF" android:importantForAccessibility="no"/>
    <LinearLayout android:id="@+id/widget_open"
     android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
     android:gravity="center" android:background="@drawable/widget_control_feedback" android:contentDescription="开锁">
     <ImageView android:layout_width="16dp" android:layout_height="16dp"
      android:src="@drawable/ic_unlock" android:importantForAccessibility="no"/>
     <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginStart="8dp" android:text="开锁" android:textSize="11sp" android:textColor="#F5F7FA"/>
    </LinearLayout>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>
</FrameLayout>
